PORT=3000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Security: Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_random_256_bit_string

# Admin JWT (separate from user JWT for extra security)
ADMIN_JWT_SECRET=change_this_to_a_different_random_string

# IP Encryption (AES-256 requires 32 bytes)
# Option 1: Use hex string (64 characters) - MOST SECURE
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IP_ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2

# Option 2: Use any text (will be hashed to 32 bytes automatically) - EASIER TO REMEMBER
# IP_ENCRYPTION_KEY=my-super-secret-nonesocial-encryption-key-2024
IP_ENCRYPTION_KEY=change_this_to_something_secret

# IP Salt for hashing (for comparison purposes)
IP_SALT=change_this_to_random_salt

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nonesocial

# Logging
LOG_LEVEL=info
